PORT=3000
NEXT_PUBLIC_REFRAQ_API_BASE_URL=/api
REFRAQ_API_UPSTREAM=http://127.0.0.1:8000
REFRAQ_MCP_UPSTREAM=http://127.0.0.1:8001
# Proxy wait for /mcp; must be >= backend REFRAQ_QUERY_TIMEOUT_SEC.
REFRAQ_QUERY_TIMEOUT_SEC=30
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
# When TLS terminates in front of next (or next serves HTTPS), set https so
# /api rewrite stamps X-Forwarded-Proto for Session Secure. Default http.
# REFRAQ_BROWSER_FACING_PROTO=https
# Browser-facing Console host or host:port (no scheme). When unset, only a
# loopback request Host is stamped as X-Forwarded-Host for OIDC callback origin.
# REFRAQ_BROWSER_FACING_HOST=127.0.0.1:3000
