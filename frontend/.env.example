PORT=3000
NEXT_PUBLIC_REFRAQ_API_BASE_URL=/api
REFRAQ_API_UPSTREAM=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
# When TLS terminates in front of next (or next serves HTTPS), set https so
# /api rewrite stamps X-Forwarded-Proto for Session Secure. Default http.
# REFRAQ_BROWSER_FACING_PROTO=https
