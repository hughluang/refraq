# Fill secrets in a site directory outside the git tree (for example
# $HOME/refraq-prod). Never commit live secrets.
# Get the runnable compose from the GitHub Release attachment, not from
# deploy/compose.yaml. This file is secrets only; do not pair it with the
# unstamped repository template as a live site.
# Compose project name is refraq-prod so existing volumes stay attached
# when the site directory moves.
# Images are linux/amd64 only. Official registry is GHCR.

INITIAL_ADMIN_ACCOUNT=root
INITIAL_ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-in-production
REFRAQ_SECRETS_MASTER_KEY=change-me-secrets-master-key
POSTGRES_PASSWORD=change-me-postgres
REFRAQ_WEB_PORT=3001
# Optional on web: set https when TLS terminates in front of the Console.
# REFRAQ_BROWSER_FACING_PROTO=https
# Browser-facing Console host or host:port (no scheme). Required when the
# Console is not loopback so OIDC redirect_uri is not taken from request Host.
# REFRAQ_BROWSER_FACING_HOST=console.example.com
