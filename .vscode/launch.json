{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run Server (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host", "127.0.0.1",
        "--port", "12000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "free-port-12000"
    },
    {
      "name": "MCP: HTTP (streamable)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "backend.metadata.mcp_http",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "REFRAQ_MCP_HOST": "127.0.0.1",
        "REFRAQ_MCP_PORT": "8001"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Celery: Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "celery",
      "args": [
        "-A",
        "backend.worker.app",
        "worker",
        "--loglevel=INFO",
        "--pool=solo",
        "--concurrency=1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "TZ": "UTC"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Celery: Beat",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "celery",
      "args": [
        "-A",
        "backend.worker.app",
        "beat",
        "--loglevel=INFO"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "TZ": "UTC"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },

    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Pytest Current File",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Pytest All Tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "args": ["backend/tests", "-v"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "API + Worker",
      "configurations": [
        "FastAPI: Run Server (uvicorn)",
        "Celery: Worker"
      ],
      "stopAll": true
    },
    {
      "name": "API + Worker + Beat + MCP",
      "configurations": [
        "FastAPI: Run Server (uvicorn)",
        "Celery: Worker",
        "Celery: Beat",
        "MCP: HTTP (streamable)"
      ],
      "stopAll": true
    }
  ]
}
