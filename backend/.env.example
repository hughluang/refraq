REFRAQ_ENV=dev
REFRAQ_API_HOST=127.0.0.1
REFRAQ_API_PORT=8000
REFRAQ_MCP_HOST=127.0.0.1
REFRAQ_MCP_PORT=8001
REFRAQ_STORE_BACKEND=persistent
# Process timezone default (override with standard TZ only; production must be UTC).
TZ=UTC
DATABASE_URL=postgresql+psycopg://refraq:refraq@127.0.0.1:5432/refraq
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
ADMIN_SESSION_SECRET=change-me
INITIAL_ADMIN_ACCOUNT=root
INITIAL_ADMIN_PASSWORD=change-me
REFRAQ_SECRETS_MASTER_KEY=change-me-secrets-master-key
# Process role is declared at the process entry (compose / launch / restart
# script), not in this shared file. Values: api | mcp | worker.
# REFRAQ_PROCESS_ROLE=api
# Optional runtime capacity (ADR 0040). Unset = process-role defaults.
# REFRAQ_DB_POOL_SIZE=8
# REFRAQ_DB_MAX_OVERFLOW=4
# REFRAQ_DB_POOL_TIMEOUT_SEC=5
# REFRAQ_DB_POOL_RECYCLE_SEC=1800
# REFRAQ_DB_STATEMENT_TIMEOUT_MS=30000
# REFRAQ_HTTP_MAX_INFLIGHT=32
# REFRAQ_THREAD_TOKENS=8
# REFRAQ_ADMISSION_SLOTS=32
# REFRAQ_ADMISSION_ACTOR_SHARE=8
# Optional. Canonical Console host or host:port (no scheme) for OIDC callback origin.
# REFRAQ_BROWSER_FACING_HOST=127.0.0.1:3000
